# ==========================================
# Comprehensive GitIgnore for Next.js Project
# ==========================================

# Dependencies & Package Managers
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js Build Outputs & Cache
/.next/
/out/
/build/
/dist/
/.turbo/
tsconfig.tsbuildinfo
*.tsbuildinfo
next-env.d.ts

# AI Assistant & Agent Artifacts
/.agents/
/.claude/
/.gemini/
/.impeccable/
PRODUCT.md
DESIGN.md

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.pfx

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Testing & Coverage
/coverage/
/.nyc_output/
